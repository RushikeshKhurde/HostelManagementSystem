# ==============================================================================
# Hostel Management System - Environment Variables Configuration Template
# Copy this file to .env or configure these environment variables in your system/IDE.
# ==============================================================================

# ===============================
# 1. Database Configuration (MySQL)
# ===============================
DB_HOST=localhost
DB_PORT=3307
DB_NAME=hostel_management_db
DB_USERNAME=root
DB_PASSWORD=root

# ===============================
# 2. JWT Security
# ===============================
# Minimum 256 bits (32 characters) secret key for HS256 JWT signing
JWT_SECRET=YourSuperSecretKeyForJwtSigningMustBeAtLeast32BytesLong!
JWT_EXPIRATION_MS=86400000

# ===============================
# 3. Email Delivery Configuration (Gmail SMTP)
# ===============================
# To send REAL OTP emails using Gmail:
# 1. Go to your Google Account -> Security.
# 2. Enable "2-Step Verification" (if not already enabled).
# 3. Go to Security -> "App passwords" (search for 'App passwords').
# 4. Generate a new App Password (e.g. name it 'HostelManagement').
# 5. Copy the 16-character generated password (without spaces) into MAIL_PASSWORD.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your16charapppassword
MAIL_FROM=your.email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# ===============================
# 4. OTP Security Parameters
# ===============================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_RATE_LIMIT_MAX_REQUESTS=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# ===============================
# 5. CORS Configuration
# ===============================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173
